# Copiar a deploy/.env y ajustar. Todos los valores tienen un valor por
# defecto en docker-compose.yml, así que el archivo es opcional.

# Imagen de PostgreSQL. Debe incluir PostGIS y h3; postgis/postgis:18-master
# trae ambas extensiones ya compiladas.
IMAGEN_POSTGRES=postgis/postgis:18-master

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
NOMBRE_BASE=vialis

# Puertos publicados en 127.0.0.1.
PUERTO_POSTGRES=5432
PUERTO_NIFI=8080

# Carpeta que NiFi vigila para las cargas manuales. Dentro tiene que haber
# subcarpetas `gtfs/` y `viajes/`.
DIR_DATOS=./datos
